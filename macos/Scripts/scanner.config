# ============================================================================
# VirtualScanner configuration
#
# This file centralizes the few values you may need to change so that a fresh
# checkout works out of the box. Every key is optional: if a key is missing
# (or this file is deleted), the scripts fall back to sane built-in defaults.
# Copy/edit it as needed; it is read by Scripts/setup.sh and
# Scripts/verify_scanner.py.
# ============================================================================

# --- Dynamic Web TWAIN Service -----------------------------------------------
# The local runtime the scanner actually talks to (used by the browser demo and
# by verify_scanner.py). Usually you don't need to change this.
DWT_SERVICE_URL=http://127.0.0.1:18622

# Where setup.sh downloads the Dynamic Web TWAIN Service installer from when
# the service is not already installed.
DWT_SERVICE_PKG_URL=https://demo.dynamsoft.com/DWT/DWTResources/dist/DynamsoftServiceSetup.pkg

# Whether setup.sh should ensure the Dynamic Web TWAIN Service is running.
#   auto   -> install/start only if it is not already running (default)
#   always -> reinstall / (re)start regardless
#   never  -> never touch it
INSTALL_DWT_SERVICE=auto

# --- Dynamsoft license -------------------------------------------------------
# Used by verify_scanner.py for LOCAL scanning.
#
# The bundled default below is a PUBLIC TRIAL key. WARNING: it has EXPIRED
# (the handshake code decodes to April 2022), so a local createJob returns
# HTTP 403 {"code":-1001,"message":"Successful."}. Replace it with your own
# key from:
#   https://www.dynamsoft.com/customer/license/trialLicense/?product=dcv&package=cross-platform
#
# The ONLINE demo (demo3.dynamsoft.com/web-twain) injects a fresh server-side
# license, so browser scanning works even without your own key.
DWT_LICENSE_KEY=DLS2eyJoYW5kc2hha2VDb2RlIjoiMjAwMDAxLTE2NDk4Mjk3OTI2MzUiLCJvcmdhbml6YXRpb25JRCI6IjIwMDAwMSIsInNlc3Npb25QYXNzd29yZCI6IndTcGR6Vm05WDJrcEQ5YUoifQ==
